<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SecureCam CCTV Store</title>

<style>
*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,sans-serif;
}

body{
background:#f5f5f5;
}

header{
background:#111;
color:#fff;
padding:20px;
text-align:center;
}

.products{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
gap:20px;
padding:30px;
}

.card{
background:#fff;
padding:15px;
border-radius:10px;
box-shadow:0 3px 10px rgba(0,0,0,.2);
text-align:center;
}

.card img{
width:100%;
height:180px;
object-fit:cover;
border-radius:8px;
}

.price{
font-size:22px;
color:#007bff;
margin:10px 0;
font-weight:bold;
}

button{
background:#007bff;
color:#fff;
border:none;
padding:12px;
width:100%;
border-radius:5px;
cursor:pointer;
font-size:16px;
}

button:hover{
background:#0056b3;
}

.cart{
background:#fff;
margin:30px;
padding:20px;
border-radius:10px;
box-shadow:0 3px 10px rgba(0,0,0,.2);
}

.cart ul{
padding-left:20px;
margin:15px 0;
}

.checkout{
background:#fff;
margin:30px;
padding:20px;
border-radius:10px;
box-shadow:0 3px 10px rgba(0,0,0,.2);
}

.checkout input{
width:100%;
padding:12px;
margin:10px 0;
border:1px solid #ccc;
border-radius:5px;
}

footer{
background:#111;
color:#fff;
text-align:center;
padding:20px;
margin-top:20px;
}
</style>

</head>
<body>

<header>
<h1>SecureCam CCTV Store</h1>
<p>Quality Security Cameras at Affordable Prices</p>
</header>

<div class="products">

<div class="card">
<img src="images/camera1.jpg" alt="">
<h3>HD Bullet Camera</h3>
<div class="price">₦25,000</div>
<button onclick="addCart('HD Bullet Camera',25000)">Add to Cart</button>
</div>

<div class="card">
<img src="images/camera2.jpg" alt="">
<h3>WiFi CCTV Camera</h3>
<div class="price">₦35,000</div>
<button onclick="addCart('WiFi CCTV Camera',35000)">Add to Cart</button>
</div>

<div class="card">
<img src="images/camera3.jpg" alt="">
<h3>PTZ Smart Camera</h3>
<div class="price">₦48,000</div>
<button onclick="addCart('PTZ Smart Camera',48000)">Add to Cart</button>
</div>

<div class="card">
<img src="images/camera4.jpg" alt="">
<h3>DVR Recorder</h3>
<div class="price">₦40,000</div>
<button onclick="addCart('DVR Recorder',40000)">Add to Cart</button>
</div>

</div>

<div class="cart">
<h2>Shopping Cart</h2>

<ul id="cartItems"></ul>

<h3>Total: ₦<span id="total">0</span></h3>

</div>

<div class="checkout">

<h2>Checkout</h2>

<input type="text" placeholder="Full Name">

<input type="text" placeholder="Phone Number">

<input type="text" placeholder="Delivery Address">

<button onclick="checkout()">Place Order</button>

</div>

<footer>

<p>© 2026 SecureCam CCTV Store</p>

</footer>

<script>

let total=0;

function addCart(name,price){

let li=document.createElement("li");

li.innerHTML=name+" - ₦"+price.toLocaleString();

document.getElementById("cartItems").appendChild(li);

total+=price;

document.getElementById("total").innerHTML=total.toLocaleString();

}

function checkout(){

if(total==0){

alert("Your cart is empty.");

return;

}

alert("Thank you for your order!\nTotal: ₦"+total.toLocaleString());

}

</script>

</body>
</html>
